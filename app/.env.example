# 前端环境变量模板
# 复制为 .env 后填入真实值

# 后端 API 地址
VITE_API_BASE_URL=http://localhost:8000

# 高德地图 JS API Key（Web端 JS API）
# 在高德开放平台 https://console.amap.com 获取
# 需要勾选「Web端(JS API)」服务
VITE_AMAP_JS_KEY=your_amap_js_key_here

# 高德地图安全密钥（JS API 2.0 必须配置）
# 在 Key 的「安全密钥」一栏获取
VITE_AMAP_SECURITY_CONFIG=your_security_config_here
