# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置 - 明确指定前端开发服务器地址
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials（用于获取景点图片）
# 获取：https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here

# 高德地图API配置（用于地图、POI搜索、天气）
# 获取：https://lbs.amap.com/
AMAP_API_KEY=your_amap_api_key_here

# LLM 配置（用于AI行程规划）
# 使用阿里云 DashScope：https://dashscope.aliyun.com/
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_ID=qwen3-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=180

# JWT 密钥（用于用户登录认证）
# 可用命令生成：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=72

# Tavily搜索（可选）- 获取API密钥：https://tavily.com/
# TAVILY_API_KEY=your_tavily_api_key_here

# SerpApi搜索（备选）- 获取API密钥：https://serpapi.com/
# SERPAPI_API_KEY=your_serpapi_key_here

# Qdrant 向量数据库配置（可选）
# QDRANT_URL=https://your-instance.us-east-1-1.aws.cloud.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here
# QDRANT_COLLECTION=hello_agents_vectors
# QDRANT_VECTOR_SIZE=384
# QDRANT_DISTANCE=cosine
# QDRANT_TIMEOUT=30

# Neo4j 图数据库配置（可选）
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# NEO4J_USERNAME=your_neo4j_username
# NEO4J_PASSWORD=your_neo4j_password
# NEO4J_DATABASE=your_database

# 嵌入（Embedding）配置（可选）
# EMBED_MODEL_TYPE=dashscope
# EMBED_MODEL_NAME=text-embedding-v4
# EMBED_API_KEY=your_embed_api_key_here
# EMBED_BASE_URL=
